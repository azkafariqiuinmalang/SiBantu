# Salin menjadi .env lalu isi URI dari Supabase > Connect > Session pooler.
# Ganti PASSWORD dengan password database yang sudah di-URL-encode.
SUPABASE_DB_URL=
# Contoh URI, sesuaikan region dan project.
# postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Isi nilai acak panjang untuk penyimpanan sesi yang stabil.
SECRET_KEY=
GDSS_PORT=5050
# Aktifkan saat memakai HTTPS di hosting.
COOKIE_SECURE=0

